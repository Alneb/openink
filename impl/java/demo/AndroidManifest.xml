<?xml version="1.0" encoding="utf-8"?>
<!-- openink test app (docs/OPEN-STACK.md). Debuggable on purpose: `adb shell run-as org.openink.demo`
     runs in the app's own SELinux domain, to test what an ordinary app may open. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.openink.demo">
    <application
        android:label="openink demo"
        android:icon="@android:drawable/ic_menu_edit"
        android:debuggable="true"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <activity android:name=".DemoActivity" android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
